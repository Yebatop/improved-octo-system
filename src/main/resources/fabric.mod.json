{
  "schemaVersion": 1,
  "id": "skirmish",
  "version": "${version}",
  "name": "Skirmish",
  "description": "Client-side PvP helper: kill cam, encrypted clan coordinates, gear inspector, anvil calculator, kill cards, waypoints.",
  "authors": [
    "Yebatop"
  ],
  "contact": {
    "sources": "https://github.com/Yebatop/improved-octo-system"
  },
  "icon": "assets/skirmish/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.skirmish.SkirmishClient"
    ]
  },
  "mixins": [
    "skirmish.mixins.json",
    "skirmish-killcam.mixins.json",
    "skirmish-clanshare.mixins.json",
    "skirmish-gearinspector.mixins.json",
    "skirmish-anvilcalc.mixins.json",
    "skirmish-killcard.mixins.json",
    "skirmish-events.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_min_version}",
    "minecraft": "~${minecraft_version}",
    "java": ">=21",
    "fabric-api": "*"
  }
}
